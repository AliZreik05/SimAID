  - scenarioName: Nausea and Vomiting
    correctMedication: Antiemetic
    answers:
    - questionType: 0
      answer: I feel nauseous and weak.
      userVoiceClip: {fileID: 8300000, guid: 9004b906572fb4b38bcebf79732821e0, type: 3}
      patientVoiceClip: {fileID: 8300000, guid: dee42b753182b4d92a8432b5ca85c177, type: 3}
    - questionType: 1
      answer: No, breathing is okay.
      userVoiceClip: {fileID: 8300000, guid: 136d352ddbc574f7ba459d5ad04a9456, type: 3}
      patientVoiceClip: {fileID: 8300000, guid: afd3fd8ea5b71498d87307c2664b5be9, type: 3}
    - questionType: 2
      answer: It started after I ate something earlier.
      userVoiceClip: {fileID: 8300000, guid: c869f767242ba4f98aa41f732bd29bee, type: 3}
      patientVoiceClip: {fileID: 8300000, guid: dff44859ee8b741e59ebb53425d3b9cd, type: 3}
    - questionType: 3
      answer: No throat tightness or swelling.
      userVoiceClip: {fileID: 8300000, guid: 4ff2448726a6e48648c7c3e5b66dea73, type: 3}
      patientVoiceClip: {fileID: 8300000, guid: d2e7fc0c0720544d7884051e6faef830, type: 3}
    - questionType: 4
      answer: Yes, I have been vomiting.
      userVoiceClip: {fileID: 8300000, guid: c7ce9a05f31a74b8a8f60cbb3046399c, type: 3}
      patientVoiceClip: {fileID: 8300000, guid: 3afb138ca12514c289e8f0eb84465fb4, type: 3}
    - questionType: 5
      answer: No, I do not have asthma.
      userVoiceClip: {fileID: 8300000, guid: 19b60bac6acec4d0cb9a5dcc08631e21, type: 3}
      patientVoiceClip: {fileID: 8300000, guid: c7cbc23d6d36f45f494abcac247670c5, type: 3}
