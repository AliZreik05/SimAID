  m_Script: {fileID: 11500000, guid: cc9e1e1cdce874658b5a187d0116a4b9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MedicalScenarioManager
  successTitleColor: {r: 0.2, g: 0.85, b: 0.35, a: 1}
  failureTitleColor: {r: 0.9, g: 0.25, b: 0.25, a: 1}
  resultBodyColor: {r: 1, g: 1, b: 1, a: 1}
  subScenarios:
  - scenarioName: Anaphylaxis
    correctMedication: Epinephrine
    answers:
    - questionType: 0
      answer: I feel really bad and dizzy.
      userVoiceClip: {fileID: 8300000, guid: 9004b906572fb4b38bcebf79732821e0, type: 3}
      patientVoiceClip: {fileID: 8300000, guid: df7ec2fa3f57a441bb2066dbc016fc6e, type: 3}
    - questionType: 1
      answer: Yes, I am having trouble breathing.
      userVoiceClip: {fileID: 8300000, guid: 136d352ddbc574f7ba459d5ad04a9456, type: 3}
      patientVoiceClip: {fileID: 8300000, guid: 5fcff6002748046d7a00df99d655c5ab, type: 3}
    - questionType: 2
      answer: This started after I ate peanuts.
      userVoiceClip: {fileID: 8300000, guid: c869f767242ba4f98aa41f732bd29bee, type: 3}
      patientVoiceClip: {fileID: 8300000, guid: ab7316e0c6e4747cfadcd1063fd38a1e, type: 3}
    - questionType: 3
      answer: Yes, my throat feels tight.
      userVoiceClip: {fileID: 8300000, guid: 4ff2448726a6e48648c7c3e5b66dea73, type: 3}
      patientVoiceClip: {fileID: 8300000, guid: 9c68db14b62ab4da6bb5f4e2457dbd03, type: 3}
    - questionType: 4
      answer: A little nauseous, but breathing is the main problem.
      userVoiceClip: {fileID: 8300000, guid: c7ce9a05f31a74b8a8f60cbb3046399c, type: 3}
      patientVoiceClip: {fileID: 8300000, guid: 64ab4c2424489428e96c03c05387761e, type: 3}
    - questionType: 5
      answer: No, I do not have asthma.
      userVoiceClip: {fileID: 8300000, guid: 19b60bac6acec4d0cb9a5dcc08631e21, type: 3}
      patientVoiceClip: {fileID: 8300000, guid: e2ef18cd4eaeb49e49d5590b7afe6b6e, type: 3}
    keyQuestions: 010000000200000003000000
    introSceneClip: {fileID: 8300000, guid: 32c708b9166a9429fbead796e64952e2, type: 3}
    assessmentObjectiveClip: {fileID: 8300000, guid: 0d5d1b16878364988a6a7a8b7b8a6507, type: 3}
    questioningObjectiveClip: {fileID: 8300000, guid: 55265da4e371d41ac83a35aaa42d9ec8, type: 3}
    medkitObjectiveClip: {fileID: 8300000, guid: 7765f7e5da88b46b7b22131546215402, type: 3}
    successClip: {fileID: 8300000, guid: b41cdb5ae2842456390d4ba40cf2cdc3, type: 3}
    failureClip: {fileID: 8300000, guid: dc83945c624b14f5db565cb42cf8150c, type: 3}
  - scenarioName: Asthma Attack
    correctMedication: Inhaler
    answers:
    - questionType: 0
      answer: My chest feels tight.
      userVoiceClip: {fileID: 8300000, guid: 9004b906572fb4b38bcebf79732821e0, type: 3}
      patientVoiceClip: {fileID: 8300000, guid: f47c0436551174347aacf46666385bb6, type: 3}
    - questionType: 1
      answer: Yes, I am short of breath and wheezing.
      userVoiceClip: {fileID: 8300000, guid: 136d352ddbc574f7ba459d5ad04a9456, type: 3}
      patientVoiceClip: {fileID: 8300000, guid: f6f83d40dfd7f407f95f5293acd340a4, type: 3}
    - questionType: 2
      answer: No, not after food or anything like that.
      userVoiceClip: {fileID: 8300000, guid: c869f767242ba4f98aa41f732bd29bee, type: 3}
      patientVoiceClip: {fileID: 8300000, guid: d6771eaa77d6e4b70af175e33b68520f, type: 3}
    - questionType: 3
      answer: No, my throat is not swelling.
      userVoiceClip: {fileID: 8300000, guid: 4ff2448726a6e48648c7c3e5b66dea73, type: 3}
      patientVoiceClip: {fileID: 8300000, guid: e27b50c61ea974a3fad6df17793d81a4, type: 3}
    - questionType: 4
      answer: No nausea or vomiting.
      userVoiceClip: {fileID: 8300000, guid: c7ce9a05f31a74b8a8f60cbb3046399c, type: 3}
      patientVoiceClip: {fileID: 8300000, guid: 3f4a2c495e5d84516b3aea275d67b034, type: 3}
    - questionType: 5
      answer: Yes, I have asthma and usually use an inhaler.
      userVoiceClip: {fileID: 8300000, guid: 19b60bac6acec4d0cb9a5dcc08631e21, type: 3}
      patientVoiceClip: {fileID: 8300000, guid: f019c40fa7ca241b683485bd3e7c486c, type: 3}
    keyQuestions: 010000000300000005000000
    introSceneClip: {fileID: 8300000, guid: 32c708b9166a9429fbead796e64952e2, type: 3}
    assessmentObjectiveClip: {fileID: 8300000, guid: 0d5d1b16878364988a6a7a8b7b8a6507, type: 3}
